<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="NetDaemon.AppModel" />
    <PackageReference Include="NetDaemon.Extensions.Mqtt" />
    <PackageReference Include="NetDaemon.Extensions.Scheduling" />
    <PackageReference Include="NetDaemon.HassModel" />
    <PackageReference Include="NetDaemon.Runtime" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Zyga.NetDaemon.Fluent.Entities\Zyga.NetDaemon.Fluent.Entities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- Gitignored local override with real HA/MQTT credentials; loaded automatically by
         Host.CreateDefaultBuilder when DOTNET_ENVIRONMENT=Development. Absent on a clean clone. -->
    <None Update="appsettings.Development.json" Condition="Exists('appsettings.Development.json')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
